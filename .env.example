# Cloudinary: crie uma conta em https://cloudinary.com
# Em Settings > Upload > Upload Presets, crie um preset "Unsigned" e copie o nome.
VITE_CLOUDINARY_CLOUD_NAME=seu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=seu_upload_preset

# EmailJS: crie uma conta em https://emailjs.com
# Em Email Services, adicione seu serviço de e-mail e copie o Service ID.
# Em Email Templates, crie um template com as variáveis abaixo e copie o Template ID.
# Em Account > API Keys, copie a Public Key.
VITE_EMAILJS_SERVICE_ID=seu_service_id
VITE_EMAILJS_TEMPLATE_ID=seu_template_id
VITE_EMAILJS_PUBLIC_KEY=sua_public_key
